# All settings are optional; these are the defaults.
MEMORYGATE_SEED=7
MEMORYGATE_CUSTOMERS=60
MEMORYGATE_K=3
MEMORYGATE_BASELINE=baselines/baseline.json

# Only needed for `--adapter ollama` (local Ollama server, no API key).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
